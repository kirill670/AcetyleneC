const TInt KErrGenConnStateMachineNotAvailable = KGenConnErrorBase -12;
*/

RESOURCE ARRAY r_error_gen_conn_errors
	{
	items=
		{
		SINGLE_ERROR
			{
			text=r_error_genconn_database_default_undefined;	// -3606
			},
		SINGLE_ERROR
			{
			text=r_error_genconn_database_type_unknown;			// -3607
			},
		SINGLE_ERROR
			{
			text=r_error_genconn_database_not_found;			// -3608
			},
		SINGLE_ERROR
			{
			text=r_error_genconn_no_packet_network;				// -3609
			},
		SINGLE_ERROR
			{
			text=r_error_genconn_incorrect_msclass;				// -3610
			},
		SINGLE_ERROR
			{
			text=r_error_genconn_inadequate_signal_strength;	// -3611
			},
		SINGLE_ERROR
			{
			text=r_error_genconn_statemachine_not_available;	// -3612
			}
		};
	}

RESOURCE TBUF r_error_genconn_database_default_undefined	{ buf=STRING_r_error_genconn_database_default_undefined; }
RESOURCE TBUF r_error_genconn_database_type_unknown			{ buf=STRING_r_error_genconn_database_type_unknown		; }
