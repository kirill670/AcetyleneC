/**
 * Phonebook icon info resource structure header.
 * Not useful and cannot be used outside Phonebook.
 * @deprecated
 */

//  STRUCTURE DEFINITIONS

#include "AknsConstants.hrh"

STRUCT PBK_ICON_INFO
    {
    // unique phonebook icon id
    BYTE pbkIconInfoId;
    // Mbm file name
    LTEXT mbmFileName;
    // icon bitmap
    LONG iconId;
    // mask bitmap
    LONG maskId;
    // Major skin id of the icon
    LONG skinIdMajor = EAknsMajorNone;
    // Minor skin id of the icon
    LONG skinIdMinor = EAknsMinorNone;
    }

// End of File
