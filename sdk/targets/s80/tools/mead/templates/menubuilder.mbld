<?xml version="1.0" encoding="UTF-8"?>

<window xmlns:symbian="http://www.symbian.com/" xmlns="http://www.mozilla.org/keymaster/gatekeeper/there.is.only.xul">
  <symbian:filelocations sourceandresourcefiles="<mead:sourceandresourcefilespath/>" headerfile="<mead:headerfilepath/>" />
  <keyset>
    <key id="EEikCmdExitKey" key="E" control="true" />
  </keyset>
  <menubar>
    <menu value="File">
      <menupopup>
	<menuitem value="Close" oncommand="EEikCmdExit" key="EEikCmdExitKey" />
      </menupopup>
    </menu>
    <menu value="Tools">
      <menupopup>
	<menuitem value="Cmd1" oncommand="E<mead:variablename/>Cmd1" />
	<menuitem value="Cmd2" oncommand="E<mead:variablename/>Cmd2" />
	<menuitem value="Cmd3" oncommand="E<mead:variablename/>Cmd3" />
	<menuitem value="Cmd4" oncommand="E<mead:variablename/>Cmd4" />
      </menupopup>
    </menu>
  </menubar>
</window>

