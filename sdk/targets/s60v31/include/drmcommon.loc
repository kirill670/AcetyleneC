//
#define qtn_drm_info_remove_fr_account "Device removed from the account" 

//d: Text in confirmation query shown when user attempts to open MO related to RO that 
//d: is about to expire. In this case RO contains accumulated time constraint and there
//d: is less than defined limit value time left. This is shown when there is more than one 
//d: or less than one minute left. If remaining time period is less than one minute,
//d: then 0 minutes is displayed.
//d: %N is number of minutes left
//l: popup_note_window_1
//w:
//r: 3.0
//
#define qtn_drm_query_n_mins_usage_left "%N minutes usage time left. View details?"

//d: Text in confirmation query shown when user attempts to open MO related to RO that 
//d: is about to expire. In this case RO contains accumulated time constraint and there
//d: is one minute of time left. 
//l: popup_note_window_1
//w:
//r: 3.0
//
#define qtn_drm_query_1_min_usage_left "1 minute usage time left. View details?" 

//d: Text in confirmation query shown when rights object has been received successfully and
